{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "upload-route": {
        "ClusterId": "upload-cluster",
        "Match": {
          "Path": "/api/upload/{**catch-all}"
        }
      },
      "results-route": {
        "ClusterId": "results-cluster",
        "Match": {
          "Path": "/api/results/{**catch-all}"
        }
      },
      "analysis-route": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/api/analysis/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "upload-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://upload-service:80"
          }
        }
      },
      "results-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://results-service:80"
          }
        }
      },
      "analysis-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://ai-analyzer-service:8000"
          }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-service:80"
          }
        }
      }
    }
  }
}
